# ============================================================================
# SBR CORE - ENVIRONMENT CONFIGURATION
# ============================================================================

# SERVER
SBR_PORT=8080
SBR_NODE_ENV=development
SBR_SERVER_URL=http://localhost:8080

# ============================================================================
# GOOGLE CLOUD CONFIGURATION
# ============================================================================
SBR_GCP_PROJECT_ID=your_gcp_project_id
SBR_GCP_PRIVATE_KEY=your_gcp_private_key
SBR_GCP_CLIENT_EMAIL=your_gcp_client_email
SBR_GCP_STORAGE_BUCKET=your_storage_bucket

# ============================================================================
# FIREBASE CONFIGURATION
# ============================================================================
SBR_FIREBASE_API_KEY=your_firebase_api_key
SBR_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
SBR_FIREBASE_PROJECT_ID=your_firebase_project_id
SBR_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
SBR_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
SBR_FIREBASE_APP_ID=your_firebase_app_id

# ============================================================================
# AI SERVICES
# ============================================================================
SBR_OPENAI_API_KEY=your_openai_api_key
SBR_ANTHROPIC_API_KEY=your_anthropic_api_key
SBR_GEMINI_API_KEY=your_gemini_api_key

# ============================================================================
# JWT SECURITY
# ============================================================================
SBR_JWT_SECRET=your_jwt_secret_key_change_in_production
SBR_JWT_EXPIRY=7d

# ============================================================================
# EXTERNAL APIs
# ============================================================================
SBR_NASA_API_KEY=your_nasa_api_key
SBR_AIRNOW_API_KEY=your_airnow_api_key
SBR_OPENWEATHER_API_KEY=your_openweather_api_key

# ============================================================================
# CORS & SECURITY
# ============================================================================
SBR_CORS_ORIGIN=http://localhost:3000,https://sbrhikmah.com,https://sbrbeautyhub.com,https://sbrbioforge.com
SBR_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH

# ============================================================================
# DATABASE
# ============================================================================
SBR_FIRESTORE_COLLECTION_PREFIX=sbr_
SBR_FIRESTORE_USERS_COLLECTION=sbr_users
