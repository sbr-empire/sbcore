# 🎯 FIRESTORE SECURITY RULES\n# Production-ready security for all collections\n\nrules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    // ========================================================================\n    // USERS COLLECTION - Personal Data\n    // ========================================================================\n    match /users/{userId} {\n      // Users can only read/write their own documents\n      allow read: if request.auth.uid == userId;\n      allow write: if request.auth.uid == userId && \n                      validateUserData();\n      allow update: if request.auth.uid == userId;\n      allow delete: if request.auth.uid == userId;\n      \n      // Subcollections\n      match /preferences/{doc=**} {\n        allow read, write: if request.auth.uid == userId;\n      }\n      \n      match /notifications/{doc=**} {\n        allow read: if request.auth.uid == userId;\n        allow write: if request.auth.uid == userId;\n      }\n    }\n    \n    // ========================================================================\n    // PRODUCTS COLLECTION - Public Read, Authenticated Write\n    // ========================================================================\n    match /products/{productId} {\n      allow read: if true; // Public\n      allow create: if isAuthenticated() && isAdmin();\n      allow update, delete: if isAuthenticated() && \n                              (isAdmin() || isProductOwner(productId));\n      \n      // Reviews subcollection\n      match /reviews/{reviewId} {\n        allow read: if true;\n        allow create: if isAuthenticated() && isPurchaser(productId);\n        allow update, delete: if isAuthenticated() && \n                               request.auth.uid == resource.data.userId;\n      }\n    }\n    \n    // ========================================================================\n    // SALONS COLLECTION\n    // ========================================================================\n    match /salons/{salonId} {\n      allow read: if true; // Public\n      allow create: if isAuthenticated() && isPartner();\n      allow update, delete: if isAuthenticated() && \n                              (isAdmin() || isSalonOwner(salonId));\n      \n      // Services subcollection\n      match /services/{serviceId} {\n        allow read: if true;\n        allow write: if isAuthenticated() && isSalonOwner(salonId);\n      }\n      \n      // Availability subcollection\n      match /availability/{availId} {\n        allow read: if true;\n        allow write: if isAuthenticated() && isSalonOwner(salonId);\n      }\n    }\n    \n    // ========================================================================\n    // BOOKINGS COLLECTION\n    // ========================================================================\n    match /bookings/{bookingId} {\n      // Users can read their own bookings\n      allow read: if request.auth.uid == resource.data.userId || \n                     isAdmin();\n      // Authenticated users can create\n      allow create: if isAuthenticated() && \n                      request.auth.uid == request.resource.data.userId;\n      // Update/delete only by owner or admin\n      allow update, delete: if request.auth.uid == resource.data.userId || \n                              isAdmin();\n    }\n    \n    // ========================================================================\n    // TRANSACTIONS COLLECTION\n    // ========================================================================\n    match /transactions/{transactionId} {\n      allow read: if request.auth.uid == resource.data.userId || \n                     isAdmin();\n      allow create: if isAuthenticated();\n      allow update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n    \n    // ========================================================================\n    // ENVIRONMENTAL DATA COLLECTION (BIOFORGE)\n    // ========================================================================\n    match /environmental_data/{dataId} {\n      // All data is public read (environmental data is important)\n      allow read: if true;\n      // Only admin can write\n      allow write: if isAdmin();\n      \n      // User-specific environmental alerts\n      match /alerts/{alertId} {\n        allow read: if request.auth.uid == resource.data.userId || true;\n        allow write: if isAuthenticated();\n      }\n    }\n    \n    // ========================================================================\n    // CUSTOM FUNCTIONS\n    // ========================================================================\n    \n    function isAuthenticated() {\n      return request.auth != null;\n    }\n    \n    function isAdmin() {\n      return isAuthenticated() && \n             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';\n    }\n    \n    function isPartner() {\n      return isAuthenticated() && \n             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'partner';\n    }\n    \n    function isSalonOwner(salonId) {\n      return isAuthenticated() && \n             get(/databases/$(database)/documents/salons/$(salonId)).data.ownerId == request.auth.uid;\n    }\n    \n    function isProductOwner(productId) {\n      return isAuthenticated() && \n             get(/databases/$(database)/documents/products/$(productId)).data.ownerId == request.auth.uid;\n    }\n    \n    function isPurchaser(productId) {\n      return isAuthenticated() && \n             exists(/databases/$(database)/documents/transactions/uid_$(request.auth.uid)_product_$(productId));\n    }\n    \n    function validateUserData() {\n      let data = request.resource.data;\n      return data.email != null &&\n             data.email is string &&\n             data.email.size() > 0 &&\n             data.createdAt != null;\n    }\n  }\n}\n"